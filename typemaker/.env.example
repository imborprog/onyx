# --- 필수 (운영) ---
# Supabase Postgres 연결 문자열 (Supavisor transaction pooler, 포트 6543).
# 비워 두면 로컬 PGlite(.data/pglite)를 씁니다. sslmode 같은 SSL 파라미터는 넣지 마세요(무시됨).
# 로컬 일반 Postgres처럼 TLS가 없는 서버만 ?sslmode=disable 을 붙입니다.
DATABASE_URL=
# DB 서버 인증서 검증용 CA (Supabase Dashboard > Database > SSL certificate, PEM).
# 한 줄로 넣을 때는 줄바꿈을 \n 으로 적어도 됩니다. 비워 두면 암호화는 되지만 인증서를 검증하지 않습니다.
DATABASE_CA_CERT=
# 배포 주소 (메일·공유 링크에 사용)
NEXT_PUBLIC_APP_URL=
# Vercel Cron 인증용 임의 문자열
CRON_SECRET=
# 접속 IP 해시(HMAC) 키. 운영 필수: Vercel이나 DATABASE_URL이 있는 환경에서 비어 있으면
# IP를 해시하는 API(테스트 만들기·리드·이벤트·문의)가 모두 500을 돌려줍니다. 예: openssl rand -hex 32
IP_HASH_SALT=

# --- AI 생성 (없으면 템플릿 초안 + 운영팀 제작 요청으로 동작) ---
ANTHROPIC_API_KEY=
# 서비스 전체 하루(24시간) AI 호출 상한. kv 'ai_daily_cap' 값이 있으면 그것이 우선합니다.
AI_DAILY_CAP=300
# 도배 방지 한도 배율 (비우면 1). 같은 PGlite 데이터로 로컬 e2e를 여러 번 돌릴 때만 100 등으로 올립니다.
RATE_LIMIT_SCALE=

# --- 결제: 토스페이먼츠 API 개별 연동 키 (없으면 계좌이체·세금계산서 문의로 전환) ---
# 카드 결제는 아래 사업자 정보(NEXT_PUBLIC_BIZ_NAME, NEXT_PUBLIC_BIZ_REG_NO)가 있어야 열립니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# --- 이메일: Resend (없으면 메일은 outbox에 쌓이고 문의 페이지에서만 답변 확인) ---
RESEND_API_KEY=
EMAIL_FROM="유형공장 <hello@example.com>"

# --- 카카오톡 공유 (JavaScript 키, 카카오 개발자 콘솔에서 사이트 도메인 등록 필요) ---
NEXT_PUBLIC_KAKAO_JS_KEY=

# --- 브랜드·사업자 정보 (전자상거래법 표시 의무) ---
NEXT_PUBLIC_BRAND_NAME=유형공장
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_BIZ_NAME=
NEXT_PUBLIC_BIZ_CEO=
NEXT_PUBLIC_BIZ_REG_NO=
NEXT_PUBLIC_BIZ_MAIL_ORDER_NO=
NEXT_PUBLIC_BIZ_ADDRESS=
NEXT_PUBLIC_BIZ_PHONE=
# 호스팅 서비스 제공자 (비우면 Vercel Inc.)
NEXT_PUBLIC_BIZ_HOSTING=

# --- 약관·개인정보처리방침 ---
# 시행일(YYYY-MM-DD)과 개인정보 보호책임자. 이 둘과 NEXT_PUBLIC_SUPPORT_EMAIL, NEXT_PUBLIC_BIZ_NAME이
# 모두 있어야 /legal/privacy의 '시행 전 초안' 표시가 사라집니다 (/legal/terms는 시행일과 상호).
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=
NEXT_PUBLIC_PRIVACY_OFFICER=
